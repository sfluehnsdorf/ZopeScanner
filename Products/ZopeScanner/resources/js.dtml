<script type="text/javascript">

	function getParentWithClass(element, selector) {
    	do {
        	element = element.parentNode;
        	if (element.classList.contains(selector)) {
        	    return element;
    	    }
	    } while (element.parentNode && element.classList);
	    console.error('could not find', selector);
	}

	function hideToggleView(element) {
		const container = getParentWithClass(element, 'toggle_view');
		if (container) {
			container.classList.remove('show_toggle_view');
		}
		return false;
	}

	function showToggleView(element) {
		const container = getParentWithClass(element, 'toggle_view')
		if (container) {
			container.classList.add('show_toggle_view');
		}
		return false;
	}

	function hideToggleViews() {
		const elements = document.getElementsByClassName("toggle_view");
		for (const element of elements) {
			element.classList.remove('show_toggle_view');
		}
		return false;
	}

	function showToggleViews() {
		const elements = document.getElementsByClassName("toggle_view");
		for (const element of elements) {
			element.classList.add('show_toggle_view');
		}
		return false;
	}

	function gotoFirstPage() {
		const element = document.getElementById("page_number");
		element.value = element.min;
		document.getElementById('control_update_button').click();
		return false;
	}

	function gotoPreviousPage() {
		const element = document.getElementById("page_number");
		let value = parseInt(element.value);
		if (value - 1 >= element.min) {
			element.value = value - 1;
		}
		document.getElementById('control_update_button').click();
		return false;
	}

	function gotoNextPage() {
		const element = document.getElementById("page_number");
		let value = parseInt(element.value);
		if (value + 1 <= element.max) {
			element.value = value + 1;
		}
		document.getElementById('control_update_button').click();
		return false;
	}

	function gotoLastPage() {
		const element = document.getElementById("page_number");
		element.value = element.max;
		document.getElementById('control_update_button').click();
		return false;
	}






</script>
